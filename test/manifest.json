{
  "manifest_version": 3,
  "name": "PII Redaction — Research Prototype",
  "version": "0.5.0",
  "description": "Client-side PII detection and tokenization for ChatGPT prompts. Regex-based detector (email, phone, SSN, credit card, IP, DOB, street address) replaces PII with reversible placeholders before requests leave the browser.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "dist/inject.bundle.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/sw.js"
  }
}
